{#- ATS-safe by construction: one column, system fonts, no tables, images,
    icons, columns or text in headers/footers. Parsers read it top to bottom. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc.name }} — Resume</title>
<style>
  @page { size: A4; margin: 16mm 18mm; }
  body { font-family: Arial, Helvetica, sans-serif; font-size: 10.5pt; line-height: 1.35; color: #000; margin: 0; }
  h1 { font-size: 18pt; margin: 0 0 2pt; }
  .contact { margin: 0 0 10pt; }
  h2 { font-size: 11.5pt; text-transform: uppercase; letter-spacing: 0.5pt; border-bottom: 1px solid #000; margin: 12pt 0 4pt; padding-bottom: 1pt; }
  h3 { font-size: 10.5pt; margin: 6pt 0 0; }
  .meta { margin: 0 0 2pt; }
  ul { margin: 2pt 0 4pt 16pt; padding: 0; }
  li { margin: 0 0 1.5pt; }
  p { margin: 0 0 3pt; }
</style>
</head>
<body>
<h1>{{ doc.name }}</h1>
<p class="contact">{{ doc.contact | join(" | ") }}</p>
{%- if doc.summary %}
<h2>Summary</h2>
<p>{{ doc.summary | join(" ") }}</p>
{%- endif %}
<h2>Experience</h2>
{%- for role in doc.roles %}
<h3>{{ role.title }}</h3>
<p class="meta">{{ role.company }}{% if role.dates %} | {{ role.dates }}{% endif %}</p>
<ul>
{%- for bullet in role.bullets %}
  <li>{{ bullet }}</li>
{%- endfor %}
</ul>
{%- endfor %}
{%- if doc.skills %}
<h2>Skills</h2>
<p>{{ doc.skills | join(", ") }}</p>
{%- endif %}
{%- if doc.projects %}
<h2>Projects</h2>
<ul>
{%- for project in doc.projects %}
  <li>{{ project }}</li>
{%- endfor %}
</ul>
{%- endif %}
{%- if doc.education %}
<h2>Education</h2>
{%- for item in doc.education %}
<p>{{ item }}</p>
{%- endfor %}
{%- endif %}
{%- if doc.certifications %}
<h2>Certifications</h2>
{%- for item in doc.certifications %}
<p>{{ item }}</p>
{%- endfor %}
{%- endif %}
</body>
</html>
