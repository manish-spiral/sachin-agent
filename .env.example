# --- Core ---
DATABASE_URL=sqlite:///data/sachin-agent.db
LOG_LEVEL=INFO

# --- Directories (defaults shown) ---
DATA_DIR=data
SNAPSHOT_DIR=snapshots
BROWSER_PROFILE_DIR=browser_profile
