# openai | groq — unset picks whichever key above is set
LLM_PROVIDER=
# Leave empty for provider defaults (shared/llm.py)
EXTRACTION_MODEL=
SCORING_MODEL=

# --- Notifications (Phase 8+) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=